{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/src/extension",
        "${workspaceFolder}/examples"
      ],
      "outFiles": ["${workspaceFolder}/src/extension/out/**/*.js"],
      "preLaunchTask": "build extension"
    }
  ]
}
